# M1.1E E2 — EnvironmentFile EXAMPLE (non-secret defaults only).
#
# Copy to the host as:
#   /etc/zikuk/zikuk-recovery-worker.env
# with ownership root:zikuk (or root:root) and mode 0600.
#
# NEVER commit a real EnvironmentFile with SUPABASE_SERVICE_ROLE_KEY.
# NEVER paste the service-role key into chat.
#
# Production first-run values (concurrency=1):

ZIKUK_RECOVERY_ENV=production
ZIKUK_RECOVERY_PROJECT_REF=comxmviofnotfwzbupxg
SUPABASE_URL=https://comxmviofnotfwzbupxg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_RUNTIME_SECRET
ZIKUK_RECOVERY_PRODUCTION_CONFIRM=I_UNDERSTAND_THIS_TARGETS_ZIKUK_PRODUCTION
ZIKUK_RECOVERY_CONCURRENCY=1
ZIKUK_RECOVERY_IDLE_MS=5000
ZIKUK_RECOVERY_LEASE_SECONDS=120
ZIKUK_RECOVERY_MAX_ATTEMPTS=3
ZIKUK_RECOVERY_ENABLED=true
ZIKUK_RECOVERY_TESSERACT_BIN=tesseract

# Do NOT set ZIKUK_RECOVERY_MAX_CYCLES on Production continuous runs.
