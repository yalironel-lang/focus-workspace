VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Desk Formatting V1 experiment (Study Session Math Desk). Default off.
# Or enable in devtools: localStorage.setItem('deskFormattingV1', '1')
# VITE_DESK_FORMATTING_V1=true

# Mission Control as course-entry on Workspace (not a separate dashboard tab). Default off.
#
# Local enable (recommended):
#   1. Copy this file to `.env.local` (gitignored) OR add the line below to `.env.local`
#   2. Set VITE_COURSE_ENTRY_BEHAVIOR_V1=true
#   3. Restart: npm run dev
#
# Quick devtools toggle (no restart; reload page after):
#   localStorage.setItem('courseEntryBehaviorV1', '1')  // on
#   localStorage.setItem('courseEntryBehaviorV1', '0')  // off (overrides .env.local)
#   localStorage.removeItem('courseEntryBehaviorV1')    // follow .env again
#
# VITE_COURSE_ENTRY_BEHAVIOR_V1=true

# Vercel project setting (also set in vercel.json): disables the floating preview toolbar.
# VERCEL_PREVIEW_FEEDBACK_ENABLED=0

# Optional. Canonical site origin for OAuth return when NOT on localhost
# (e.g. behind a reverse proxy). Leave unset on normal Vercel deploys —
# the app uses window.location.origin. Do NOT set this to production while
# developing locally; localhost always ignores this override.
# VITE_AUTH_REDIRECT_ORIGIN=https://your-production-domain.com
