VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Desk Formatting V1 experiment (Study Session Math Desk). Default off.
# Or enable in devtools: localStorage.setItem('deskFormattingV1', '1')
# VITE_DESK_FORMATTING_V1=true

# TipTap Notebook body editor — DEFAULT ON (M7.1A/D).
# Normal path: TipTap is the Notebook body editor with guarded canonical persistence.
# Explicit OFF via env restores CE for that flag only:
# VITE_NOTEBOOK_TIPTAP_CANDIDATE=false
# DEV-only: localStorage notebookTiptapCandidate 1/0 (ignored in production builds).
# Production emergency CE rollback uses notebookLegacyCe / VITE_NOTEBOOK_LEGACY_CE only.

# TipTap guarded persistence — DEFAULT ON (canonical body; never TipTap JSON).
# Explicit OFF keeps TipTap visible but memory-only (no TipTap→persist bridge).
# VITE_NOTEBOOK_TIPTAP_PERSIST=false
# localStorage.setItem('notebookTiptapPersist', '0')

# Emergency: force legacy contentEditable body editor (DEFAULT OFF).
# Highest priority for body-editor selection — overrides TipTap ON flags.
# VITE_NOTEBOOK_LEGACY_CE=true
# Or: localStorage.setItem('notebookLegacyCe', '1')
# Disable: localStorage.setItem('notebookLegacyCe', '0') or remove the key.

# TipTap shadow / parity DEV surfaces only (Milestone 0–3). Default OFF.
# Does not select the production body editor.
# VITE_NOTEBOOK_TIPTAP_EDITOR=true
# Or: localStorage.setItem('notebookTiptapEditor', '1')

# Notebook engineering chrome (QA JSON / status strip / selection diag). DEFAULT OFF.
# Normal localhost stays product-like; enable only for explicit engineering QA.
# VITE_NOTEBOOK_ENGINEERING_CHROME=true
# Or: localStorage.setItem('notebookEngineeringChrome', '1')
# Disable: localStorage.setItem('notebookEngineeringChrome', '0') or remove the key.

# Mission Control as course-entry on Workspace (not a separate dashboard tab). Default off.
#
# Local enable (recommended):
#   1. Copy this file to `.env.local` (gitignored) OR add the line below to `.env.local`
#   2. Set VITE_COURSE_ENTRY_BEHAVIOR_V1=true
#   3. Restart: npm run dev
#
# Quick devtools toggle (no restart; reload page after):
#   localStorage.setItem('courseEntryBehaviorV1', '1')  // on
#   localStorage.setItem('courseEntryBehaviorV1', '0')  // off (overrides .env.local)
#   localStorage.removeItem('courseEntryBehaviorV1')    // follow .env again
#
# M1.1F — historical Free Space PDF enrollment on Ask open (default ON).
# Emergency kill switch (build-time): set false and redeploy.
# Session override: localStorage courseKnowledgeHistoricalEnroll=0
# VITE_COURSE_KNOWLEDGE_HISTORICAL_ENROLL=false
# Enables NEW historical marks only; does not affect new-upload ingestion or OCR worker.
# Optional. Live Supabase round-trip tests (migration 009 desk/math validation).
# VITE_LIVE_TEST_EMAIL=your-test-user@example.com
# VITE_LIVE_TEST_PASSWORD=your-test-password

# Vercel project setting (also set in vercel.json): disables the floating preview toolbar.
# VERCEL_PREVIEW_FEEDBACK_ENABLED=0

# Optional. Canonical site origin for OAuth return when NOT on localhost
# (e.g. behind a reverse proxy). Leave unset on normal Vercel deploys —
# the app uses window.location.origin. Do NOT set this to production while
# developing locally; localhost always ignores this override.
# VITE_AUTH_REDIRECT_ORIGIN=https://your-production-domain.com

# -----------------------------------------------------------------------------
# ZIKUK AI Gateway (M0.2) — SERVER-ONLY secrets (Supabase Edge Function)
# Set via Supabase Dashboard → Edge Functions → Secrets, or `supabase secrets set`.
# NEVER put these in VITE_*, .env client files, localStorage, or the browser bundle.
#
#   AI_PROVIDER_API_KEY=...
#   AI_PROVIDER_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini
#
# M0.5C embeddings (server-only; reuse AI_PROVIDER_* key/base URL):
#   AI_EMBEDDING_MODEL=text-embedding-3-small
#   AI_EMBEDDING_DIMENSIONS=1536
#
# SUPABASE_URL / SUPABASE_ANON_KEY are injected automatically into Edge Functions.
# Launch requirement (not in M0.2): durable per-user rate limiting across isolates.
# -----------------------------------------------------------------------------
